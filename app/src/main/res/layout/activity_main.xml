<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue"
        android:elevation="4dp"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:menu="@menu/main"
            app:navigationIcon="@drawable/ic_photo"
            app:title="@string/app_name"
            app:titleTextColor="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status-Karte -->
            <LinearLayout
                style="@style/Card"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipWifi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_ok"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="WLAN verbunden"
                        android:textColor="@color/green"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_wifi"
                        app:drawableTint="@color/green" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvHost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/grey"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvBig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/grey"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    app:indicatorColor="@color/blue"
                    app:trackColor="@color/track"
                    app:trackCornerRadius="5dp"
                    app:trackThickness="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/statNew" style="@style/StatNumber" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="neu kopiert" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/StatBox"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">
                        <TextView android:id="@+id/statAlready" style="@style/StatNumber" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="schon da" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/statFailed" style="@style/StatNumber" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="Fehler" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/grey"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/ic_folder"
                    app:drawableTint="@color/grey" />
            </LinearLayout>

            <!-- Hinweis Berechtigung -->
            <LinearLayout
                android:id="@+id/permBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_info"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Die App darf noch nicht auf deine Fotos zugreifen. Bitte „Alle erlauben“ wählen, nicht nur ausgewählte Fotos."
                    android:textColor="@color/blue_text"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPerms"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berechtigungen erteilen" />
            </LinearLayout>

            <!-- Schalter -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="14dp"
                android:paddingStart="18dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swVideos"
                    style="@style/SwitchRow"
                    android:text="Videos auch übertragen" />

                <View style="@style/Divider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swCamera"
                    style="@style/SwitchRow"
                    android:text="Nur Kamera-Fotos" />

                <View style="@style/Divider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAuto"
                    style="@style/SwitchRow"
                    android:text="Automatisch im WLAN" />
            </LinearLayout>

            <!-- Verlauf -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.06"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="VERLAUF"
                android:textColor="@color/grey"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/text2"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSync"
            style="@style/BigButton"
            android:text="Jetzt übertragen" />
    </LinearLayout>
</LinearLayout>
